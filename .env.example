# Development: preserve your existing .env and add settings as needed.
SARVAM_API_KEY=
APP_ENV=development
STORAGE_MODE=local
AI_ENABLED=true
SARVAM_CHAT_MODEL=sarvam-105b-conversations
SARVAM_ANALYSIS_MODEL=sarvam-105b
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v4-flash
SARVAM_TTS_VOICE_HI=shubh_enhi_ads
SARVAM_TTS_VOICE_EN=shubh_enhi_ads
SARVAM_TRANSLATE_MODEL=mayura:v1
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_STORAGE_BUCKET=case-documents
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=3
MAX_UPLOAD_BATCH_MB=3
MAX_DOCUMENT_PAGES=10
MAX_AUDIO_SECONDS=25
MAX_REQUESTS_PER_USER_PER_HOUR=60
MAX_DOCUMENT_PAGES_PER_USER_PER_DAY=30
MAX_AUDIO_SECONDS_PER_USER_PER_DAY=300
